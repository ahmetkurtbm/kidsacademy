NEXT_PUBLIC_SUPABASE_URL=https://PROJE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_ANAHTARI

# Admin paneline girmek için kullanılacak sabit şifre.
ADMIN_PASSWORD=sifre

# Oturum çerezlerini imzalar. En az 24 karakter, rastgele ve gizli olmalı.
SESSION_SECRET=sifre

# Sitemap, robots.txt ve Open Graph etiketleri için yayındaki domain (sonda / olmadan).
NEXT_PUBLIC_SITE_URL=https://domain.com

# --- Gözlemlenebilirlik (Grafana Cloud / OpenTelemetry) ---
# Bu uygulamanın controlpanel'de hangi isimle görüneceği.
OTEL_SERVICE_NAME=kidsacademy
# Grafana Cloud > Connections > OpenTelemetry sayfasından alınır.
# Diğer projelerle (gatehub vb.) aynı değerler kullanılır.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
